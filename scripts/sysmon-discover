#!/usr/bin/env sh

# Slow-cadence facts for Service.qml, plus discovery of the sysfs files the
# in-process sampler reads directly via FileView: the CPU package temperature
# and every hwmon fan (with label). The fast-changing values themselves are
# NOT sampled here — only where to find them. Output is one
# "<key> <value...>" line per fact:
#
#   temp <path>
#   fan <path> <label...>
#   diskfs <pct> <usedKb> <freeKb> <totalKb> <device> <mount>
#   gpu <device dir> <card> <driver> <sysfs|fdinfo>
#   gpusensors <temp file|-> <power file|-> <clock file|-> <hz|mhz> <power label...>
#
# Ported from willshell's system-monitor-slow / system-monitor-temp-path.

sysfs_root=${SYSMON_SYSFS_ROOT:-/sys}

sane() {
  [ -r "$1" ] || return 1
  value=$(cat "$1" 2>/dev/null)
  case "$value" in ''|*[!0-9]*) return 1;; esac
  c=$((value / 1000))
  [ "$c" -gt 0 ] && [ "$c" -lt 130 ]
}

# Sysfs numbering is probe-order dependent, so the first thermal zone is often
# an ACPI board or ambient sensor rather than the CPU. Prefer semantic hwmon
# labels and known CPU drivers, falling back to first-sane-source.
find_temp_path() {
  package0=""
  control=""
  die=""
  package_any=""
  for f in "$sysfs_root"/class/hwmon/hwmon*/temp*_input; do
    sane "$f" || continue
    base=${f%_input}
    label=$(cat "${base}_label" 2>/dev/null | tr '[:upper:]' '[:lower:]')
    case "$label" in
      "package id 0"|"physical id 0"|"cpu package")
        [ -n "$package0" ] || package0=$f ;;
      tctl)
        [ -n "$control" ] || control=$f ;;
      tdie)
        [ -n "$die" ] || die=$f ;;
      "package id "*|"physical id "*)
        [ -n "$package_any" ] || package_any=$f ;;
    esac
  done

  for f in "$package0" "$control" "$die" "$package_any"; do
    if [ -n "$f" ]; then printf '%s\n' "$f"; return 0; fi
  done

  # Some CPU temperature drivers do not provide useful per-input labels.
  for d in "$sysfs_root"/class/hwmon/hwmon*; do
    [ -r "$d/name" ] || continue
    name=$(cat "$d/name" 2>/dev/null | tr '[:upper:]' '[:lower:]')
    case "$name" in
      coretemp|k10temp|zenpower|cputemp|cpu_thermal|cpu-thermal)
        for f in "$d"/temp*_input; do
          if sane "$f"; then printf '%s\n' "$f"; return 0; fi
        done ;;
    esac
  done

  # Thermal zones have a stable type even though thermal_zoneN does not have a
  # stable number. Avoid broad names such as acpitz and INT3400 Thermal here.
  for d in "$sysfs_root"/class/thermal/thermal_zone*; do
    [ -r "$d/type" ] || continue
    type=$(cat "$d/type" 2>/dev/null | tr '[:upper:]' '[:lower:]')
    case "$type" in
      x86_pkg_temp|cpu_thermal|cpu-thermal|cpu[0-9]*-thermal|soc_thermal|soc-thermal|tcpu)
        if sane "$d/temp"; then printf '%s\n' "$d/temp"; return 0; fi ;;
    esac
  done

  # Unknown hardware: show something rather than nothing.
  for f in "$sysfs_root"/class/thermal/thermal_zone*/temp "$sysfs_root"/class/hwmon/hwmon*/temp*_input; do
    if sane "$f"; then printf '%s\n' "$f"; return 0; fi
  done
  return 1
}

temp_path=$(find_temp_path)
[ -n "$temp_path" ] && echo "temp $temp_path"

# Label comes from fanN_label when the driver provides one, else
# "<hwmon name> fanN".
for f in "$sysfs_root"/class/hwmon/hwmon*/fan*_input; do
  [ -r "$f" ] || continue
  dir=${f%/*}
  idx=${f##*/}
  idx=${idx%_input}
  label=$(cat "$dir/${idx}_label" 2>/dev/null)
  if [ -z "$label" ]; then
    hname=$(cat "$dir/name" 2>/dev/null)
    label="${hname:-hwmon} $idx"
  fi
  echo "fan $f $label"
done

# The GPU. amdgpu reports its own busy percentage (gpu_busy_percent), so an
# AMD card wins. Intel (i915, xe) and Qualcomm (msm) report busy time per
# client in DRM fdinfo instead, which scripts/sysmon-gpu-busy adds up; the
# source field says which reader Service.qml starts. NVIDIA's driver has
# neither, so it gets no reading.
amd_card=
fd_card=
for d in "$sysfs_root"/class/drm/card[0-9]*; do
  case ${d##*/} in *-*) continue ;; esac
  [ -d "$d/device/drm" ] || continue
  driver=$(basename "$(readlink "$d/device/driver" 2>/dev/null)" 2>/dev/null)
  if [ -r "$d/device/gpu_busy_percent" ]; then
    [ -n "$amd_card" ] || amd_card=$d
  else
    case $driver in
      i915|xe|msm*) [ -n "$fd_card" ] || fd_card=$d ;;
    esac
  fi
done

# The hottest thermal zone whose type names the GPU (Qualcomm has one per
# GPU cluster, gpuss-0..7-thermal).
hottest_gpu_zone() {
  best=
  best_temp=0
  for z in "$sysfs_root"/class/thermal/thermal_zone*; do
    case $(cat "$z/type" 2>/dev/null) in
      gpu*|*-gpu*) ;;
      *) continue ;;
    esac
    sane "$z/temp" || continue
    t=$(cat "$z/temp")
    if [ -z "$best" ] || [ "$t" -gt "$best_temp" ]; then
      best=$z/temp
      best_temp=$t
    fi
  done
  [ -n "$best" ] && printf '%s\n' "$best"
}

# The card's own hwmon: temperature, power, and (amdgpu) the shader clock in
# Hz. On an APU the power sensor is "PPT", the whole package, so its label is
# passed through for the card to say so.
temp=- power=- clock=- unit=hz plabel=power
read_hwmon() {
  for h in "$1"/hwmon/hwmon*; do
    [ -d "$h" ] || continue
    for f in "$h"/temp1_input "$h"/temp*_input; do
      if sane "$f"; then temp=$f; break; fi
    done
    if [ -r "$h/power1_average" ]; then power="$h/power1_average"
    elif [ -r "$h/power1_input" ]; then power="$h/power1_input"
    fi
    [ -r "$h/freq1_input" ] && clock="$h/freq1_input"
    plabel=$(cat "$h/power1_label" 2>/dev/null)
    plabel=${plabel:-power}
    break
  done
}

if [ -n "$amd_card" ]; then
  d=$amd_card
  driver=$(basename "$(readlink "$d/device/driver" 2>/dev/null)" 2>/dev/null)
  echo "gpu $d/device ${d##*/} ${driver:-amdgpu} sysfs"
  read_hwmon "$d/device"
  echo "gpusensors $temp $power $clock $unit $plabel"
elif [ -n "$fd_card" ]; then
  d=$fd_card
  driver=$(basename "$(readlink "$d/device/driver" 2>/dev/null)" 2>/dev/null)
  read_hwmon "$d/device"
  case $driver in
    i915)
      # Actual GT frequency in MHz, 0 while the GT sleeps (RC6).
      for f in "$d/gt/gt0/rps_act_freq_mhz" "$d/gt_act_freq_mhz"; do
        if [ -r "$f" ]; then clock=$f; unit=mhz; break; fi
      done ;;
    xe)
      for f in "$d"/device/tile0/gt0/freqs/act_freq; do
        if [ -r "$f" ]; then clock=$f; unit=mhz; fi
      done ;;
    msm*)
      # The display card owns the DRM nodes; the GPU itself has no hwmon,
      # but its devfreq gives the clock in Hz and the thermal zones its
      # temperature.
      driver=msm
      for f in "$sysfs_root"/class/devfreq/*gpu*/cur_freq; do
        if [ -r "$f" ]; then clock=$f; unit=hz; break; fi
      done
      zone=$(hottest_gpu_zone)
      [ -n "$zone" ] && temp=$zone ;;
  esac
  echo "gpu $d/device ${d##*/} $driver fdinfo"
  echo "gpusensors $temp $power $clock $unit $plabel"
fi

# Real filesystems, deduped by device; btrfs subvolume mounts share a device,
# so keep the shortest mountpoint.
df -Pk -x tmpfs -x devtmpfs -x efivarfs -x overlay 2>/dev/null | awk '
  NR > 1 {
    dev = $1
    pct = $5
    gsub(/%/, "", pct)
    mp = $6
    for (i = 7; i <= NF; i++) mp = mp " " $i
    if (!(dev in best) || length(mp) < length(best[dev])) {
      best[dev] = mp
      line[dev] = "diskfs " pct " " $3 " " $4 " " $2 " " dev " " mp
    }
  }
  END { for (d in line) print line[d] }
' | sort -k7

exit 0
